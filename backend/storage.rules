rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============ FUNCIONES AUXILIARES ============

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024; // Máximo 10MB
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 50 * 1024 * 1024; // Máximo 50MB
    }

    // ============ EVIDENCIAS DE ALERTAS ============
    match /alerts/{alertId}/{fileName} {
      // Lectura: usuarios autenticados (operadores necesitan ver evidencias)
      allow read: if isAuthenticated();

      // Escritura: solo el creador de la alerta, imágenes o videos válidos
      allow write: if isAuthenticated()
        && (isValidImage() || isValidVideo());
    }

    // ============ FOTOS DE PERFIL ============
    match /users/{userId}/profile/{fileName} {
      // Lectura: todos los autenticados
      allow read: if isAuthenticated();

      // Escritura: solo el propietario, solo imágenes
      allow write: if isOwner(userId) && isValidImage();
    }

    // ============ LOGOS DE INSTITUCIONES ============
    match /institutions/{institutionId}/{fileName} {
      // Lectura: todos los autenticados
      allow read: if isAuthenticated();

      // Escritura: restringido (solo mediante admin SDK)
      allow write: if false;
    }
  }
}
