rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ FUNCIONES AUXILIARES ============

    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtener datos del usuario actual
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verificar rol del usuario
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Verificar si es el propietario del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verificar si es ciudadano
    function isCitizen() {
      return hasRole('citizen');
    }

    // Verificar si es agente
    function isAgent() {
      return hasRole('agent');
    }

    // Verificar si es administrador
    function isAdmin() {
      return hasRole('admin');
    }

    // Verificar si es agente o admin
    function isAgentOrAdmin() {
      return isAgent() || isAdmin();
    }

    // ============ COLECCIÓN: users ============
    match /users/{userId} {
      // Lectura: usuario propio, agentes, admins, o cualquier autenticado leyendo perfil de agente
      allow read: if isOwner(userId) || isAgentOrAdmin() || (isAuthenticated() && resource.data.role == 'agent');

      // Creación: solo mediante Cloud Functions (registro)
      allow create: if false;

      // Actualización: usuario propio (campos limitados) o admin
      allow update: if isOwner(userId) && onlyUpdatingAllowedFields() || isAdmin();

      // Eliminación: solo admin
      allow delete: if isAdmin();

      function onlyUpdatingAllowedFields() {
        let allowedFields = ['phone', 'address', 'expoPushToken', 'lastLocation', 'updatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
      }
    }

    // ============ COLECCIÓN: alerts ============
    match /alerts/{alertId} {
      // Lectura: cualquier usuario autenticado (alertas son info de seguridad pública)
      allow read: if isAuthenticated();

      // Creación: solo ciudadanos autenticados
      allow create: if isCitizen() && validAlertData();

      // Actualización: agentes (cambio de estado), admin, o ciudadano creador (solo rating)
      allow update: if (isAgentOrAdmin() && validAlertUpdate())
        || (isCitizen() && isOwner(resource.data.createdBy) && onlyUpdatingRating());

      // Eliminación: solo admin
      allow delete: if isAdmin();

      function validAlertData() {
        let data = request.resource.data;
        return data.keys().hasAll(['type', 'description', 'location', 'urgency', 'createdBy'])
          && data.createdBy == request.auth.uid
          && data.status == 'pending';
      }

      function validAlertUpdate() {
        let validStatuses = ['pending', 'assigned', 'in_progress', 'resolved', 'cancelled'];
        return request.resource.data.status in validStatuses;
      }

      function onlyUpdatingRating() {
        let allowedFields = ['rating', 'ratingId', 'updatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
      }
    }

    // ============ COLECCIÓN: institutions ============
    match /institutions/{institutionId} {
      // Lectura: todos los usuarios autenticados
      allow read: if isAuthenticated();

      // Escritura: solo admin
      allow write: if isAdmin();
    }

    // ============ COLECCIÓN: categories ============
    match /categories/{categoryId} {
      // Lectura: todos los usuarios autenticados
      allow read: if isAuthenticated();

      // Escritura: solo admin
      allow write: if isAdmin();
    }

    // ============ COLECCIÓN: ratings ============
    match /ratings/{ratingId} {
      // Lectura: creador, agente asignado y admins
      allow read: if isOwner(resource.data.ratedBy) || isAgentOrAdmin();

      // Creación: ciudadano que creó la alerta relacionada
      allow create: if isCitizen() && validRatingData();

      // Actualización y eliminación: no permitido
      allow update, delete: if false;

      function validRatingData() {
        let data = request.resource.data;
        return data.keys().hasAll(['alertId', 'rating', 'ratedBy'])
          && data.rating >= 1 && data.rating <= 5
          && data.ratedBy == request.auth.uid
          && data.keys().hasOnly(['alertId', 'rating', 'ratedBy', 'comment', 'agentId', 'createdAt']);
      }
    }

    // ============ COLECCIÓN: notifications ============
    match /notifications/{notificationId} {
      // Lectura: solo el destinatario
      allow read: if isOwner(resource.data.userId);

      // Creación: solo mediante Cloud Functions
      allow create: if false;

      // Actualización: destinatario puede marcar como leída
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

      // Eliminación: destinatario o admin
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
