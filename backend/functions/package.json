{
  "name": "savia-functions",
  "version": "1.0.0",
  "description": "Cloud Functions para SAVIA - Sistema de Alertas Vecinales",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "start": "pnpm shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.0",
    "expo-server-sdk": "^4.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "ngeohash": "^0.6.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0"
  },
  "private": true
}
