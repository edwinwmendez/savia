# ============================================
# SAVIA - .gitignore Global (Monorepo)
# ============================================

# ============ DEPENDENCIAS ============
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ============ BUILD / COMPILADOS ============
dist/
build/
lib/
out/
.next/
web-build/

# ============ EXPO / REACT NATIVE ============
.expo/
.kotlin/
expo-env.d.ts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
.metro-health-check*

# Carpetas nativas generadas (Expo prebuild)
**/ios/
**/android/

# ============ FIREBASE / BACKEND ============
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
database-debug.log

# ============ VARIABLES DE ENTORNO ============
.env
.env.*
!.env.example

# ============ TYPESCRIPT ============
*.tsbuildinfo
next-env.d.ts

# ============ TESTING ============
coverage/
.nyc_output/

# ============ IDE / EDITORES ============
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# ============ SISTEMA OPERATIVO ============
.DS_Store
Thumbs.db
*.log

# ============ DEBUG LOGS ============
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============ HOSTING / DEPLOY ============
.vercel
.netlify

# ============ CACHE ============
.cache/
*.cache

# ============ FIREBASE SERVICE ACCOUNT KEYS ============
*-firebase-adminsdk-*.json

# ============ MISC ============
*.local
.temp/
tmp/
